# systemd *user* service. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/monkeymadness.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now monkeymadness
#   loginctl enable-linger $USER   # keep it running after you log out
[Unit]
Description=MonkeyMadness leaderboard
After=network.target

[Service]
WorkingDirectory=%h/projects/school/liuais/MonkeyMadness/web
ExecStart=/usr/bin/env node --env-file=.env.production build
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
