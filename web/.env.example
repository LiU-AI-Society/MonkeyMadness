# Production settings for `node --env-file=.env.production build`.
# Copy to .env.production (gitignored) and fill in.

# Public address. Required behind a reverse proxy: SvelteKit rejects form posts
# (admin login) from any other origin, and it decides whether cookies are https-only.
ORIGIN=https://mm.jakobtor.casa
PORT=3000
HOST=127.0.0.1
# Real client IPs for the per-IP limit, from the reverse proxy.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Uploads: adapter-node's default body limit is 512K, far too small for models.
BODY_SIZE_LIMIT=60M

ADMIN_PASSWORD=change-me

# Scoring. Defaults: ../leaderboard/venv, ~/.monkeymadness/hidden_test, ~/.monkeymadness/gold_labels.csv.
# LEADERBOARD_TEST_DIR=/path/to/hidden_test
# LEADERBOARD_GOLD_CSV=/path/to/gold_labels.csv
# PYTHON=/path/to/venv/bin/python
LEADERBOARD_COOLDOWN_SECONDS=60
LEADERBOARD_TIMEOUT_SECONDS=120
LEADERBOARD_MAX_UPLOAD_MB=50
SCORING_CONCURRENCY=2
MAX_QUEUE=30
IP_LIMIT_PER_MINUTE=10

# Where the SQLite database and pending uploads live.
DATA_DIR=data
